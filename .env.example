# --- Gemini prediction-market sandbox (the exchange). Orders need keys; the client is always env: "sandbox". ---
GEMINI_API_KEY=            # sandbox API key
GEMINI_API_SECRET=         # sandbox API secret
GEMINI_ACCOUNT=primary     # sandbox sub-account name used for orders

# --- Forecaster Council (Vercel AI SDK). One of these is enough. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Wallets (0x + 64 hex private keys, testnet only). If unset, ~/.cassandra/keys.env is read. ---
AGENT_PRIVATE_KEY=         # commits forecasts, records trades
OWNER_PRIVATE_KEY=         # deploys contracts; resolver fallback; smoke signs as the owner with it
OWNER_ADDRESS=             # AgentPolicy owner (the human wallet); defaults to the OWNER_PRIVATE_KEY address
RESOLVER_PRIVATE_KEY=      # resolves CalibrationLedger markets; falls back to OWNER_PRIVATE_KEY

# --- Optional: fresh web context for the Reporter persona ---
CONTEXT_DEV_API_KEY=

# --- Chain ---
CHAIN_NETWORK=bscTestnet   # bscTestnet | local (anvil on LOCAL_RPC_URL)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545   # fallback: https://bsc-testnet-rpc.publicnode.com
LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Loop ---
TICK_SECONDS=120           # executor tick; 20 s when DEMO_MODE=true
DEMO_MODE=false
REVEAL_DELAY_SECONDS=0     # 0 for the demo; production reveals at resolution
COUNCIL_MAX_RUNS_PER_HOUR=40
AUTO_COUNCIL=true          # false = council only runs on POST /api/run/:symbol
TRACKED_CONTRACTS=24

# --- Dry-run switches: fixtures / no-op adapters, always badged in the UI ---
DRY_RUN_GEMINI=false
DRY_RUN_CHAIN=false
DRY_RUN_LLM=false

# --- Web ---
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
